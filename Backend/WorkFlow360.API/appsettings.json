{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Company": {
    "TimeZone": "Asia/Dhaka",
    "WeekendDays": [ "Friday", "Saturday" ]
  },
  "Attendance": {
    "OfficeStartTime": "09:00",
    "GraceMinutes": 15
  },
  "Jwt": {
    "Issuer": "WorkFlow360",
    "Audience": "WorkFlow360.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/workflow360-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
